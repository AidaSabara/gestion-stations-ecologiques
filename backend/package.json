{
  "name": "eco-stations-backend",
  "version": "1.0.0",
  "description": "Backend API pour la gestion des stations écologiques",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:passwords": "npx ts-node src/scripts/migrate-passwords.ts",
    "train:sanar": "ts-node src/scripts/train-sanar-models.ts",
    "train:gandiol": "ts-node src/scripts/train-gandiol-models.ts",
    "train:all": "npm run train:sanar && npm run train:gandiol",
    "evaluate:models": "ts-node src/scripts/evaluate-all-models.ts"
  },
  "keywords": [
    "eco",
    "stations",
    "kuzzle",
    "jwt",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.8",
    "@types/nodemailer": "^7.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.4",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "kuzzle-sdk": "^7.15.1",
    "ml-matrix": "^6.12.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  }
}
